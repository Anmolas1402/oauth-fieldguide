# Copy to .env.local and fill in. Never commit real keys.
# One model key is required for live research and guide writing. It is read only by the server.

# Google Gemini (free key from https://aistudio.google.com/apikey). Used when set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING=LOW            # MINIMAL | LOW | MEDIUM | HIGH (research turns default LOW, guide writing MEDIUM)

# Anthropic Claude, used when no Gemini key is set (or set MODEL_PROVIDER=anthropic).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_FALLBACKS=off

# MODEL_PROVIDER=gemini          # force a provider when both keys are set
# PORT=8787
# RATE_LIMIT_PER_HOUR=6
# DAILY_LIVE_RUN_CAP=60
