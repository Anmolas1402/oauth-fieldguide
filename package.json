{
  "name": "oauth-fieldguide",
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"FIELDGUIDE_DEV=1 tsx watch server/node.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/node.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "save-guide": "tsx scripts/save-guide.ts",
    "check-model": "tsx scripts/check-model.ts"
  },
  "description": "Investigates what it takes to register an OAuth app with a provider and writes an evidence-grounded setup guide.",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@google/genai": "^2.32.0",
    "@hono/node-server": "^2.1.6",
    "dotenv": "^18.0.10",
    "hono": "^4.13.17",
    "html-to-text": "^10.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  }
}
